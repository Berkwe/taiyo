model Series {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String                @unique
  originalLanguage   Languages
  type               SeriesType
  status             SeriesStatus
  contentRating      PlatformContentRating @default(TEEN)
  publicationYear    Int?
  coverStorageKey    String?
  bannerStorageKey   String?
  defaultAccentColor String?
  isFeatured         Boolean               @default(false)
  isSearchable       Boolean               @default(true)
  isIndexable        Boolean               @default(true)
  publishedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  localizations SeriesLocalization[]
  aliases       SeriesAlias[]
  creators      SeriesCreator[]
  genres        SeriesGenre[]
  tags          SeriesTag[]
  chapters      PlatformChapter[]
  followers     SeriesFollow[]
  notifications SiteNotification[]

  @@index([status, isSearchable, deletedAt])
  @@index([isFeatured, publishedAt])
}

model SeriesLocalization {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale                 Languages
  title                  String
  shortTitle             String?
  description            String
  seoTitleOverride       String?
  seoDescriptionOverride String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId String @db.Uuid

  @@unique([seriesId, locale])
  @@index([locale, title])
}

model SeriesAlias {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale          Languages?
  alias           String
  normalizedAlias String
  type            SeriesAliasType @default(ALTERNATIVE)
  createdAt       DateTime        @default(now())

  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId String @db.Uuid

  @@unique([seriesId, locale, normalizedAlias])
  @@index([normalizedAlias])
}

model PlatformCreator {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  series SeriesCreator[]
}

model SeriesCreator {
  role      CreatorRole
  sortOrder Int         @default(0)

  series    Series          @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId  String          @db.Uuid
  creator   PlatformCreator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String          @db.Uuid

  @@id([seriesId, creatorId, role])
}

model Genre {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  localizations GenreLocalization[]
  series        SeriesGenre[]
}

model GenreLocalization {
  locale Languages
  name   String

  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId String @db.Uuid

  @@id([genreId, locale])
  @@unique([locale, name])
}

model SeriesGenre {
  sortOrder Int @default(0)

  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId String @db.Uuid
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId  String @db.Uuid

  @@id([seriesId, genreId])
}

model PlatformTag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  localizations TagLocalization[]
  series        SeriesTag[]
}

model TagLocalization {
  locale Languages
  name   String

  tag   PlatformTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId String      @db.Uuid

  @@id([tagId, locale])
  @@unique([locale, name])
}

model SeriesTag {
  series   Series      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId String      @db.Uuid
  tag      PlatformTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId    String      @db.Uuid

  @@id([seriesId, tagId])
}

model PlatformChapter {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapterNumber       String
  volumeNumber        String?
  sortKey             Int
  canonicalSlug       String
  originalPublishedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  series        Series                @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId      String                @db.Uuid
  localizations ChapterLocalization[]
  releases      ChapterRelease[]

  @@unique([seriesId, chapterNumber])
  @@unique([seriesId, canonicalSlug])
  @@index([seriesId, sortKey])
}

model ChapterLocalization {
  locale      Languages
  title       String?
  description String?

  chapter   PlatformChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId String          @db.Uuid

  @@id([chapterId, locale])
}

model TranslationProfile {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String   @unique
  labelKey               String
  descriptionKey         String
  sortOrder              Int
  badgeStyle             String?
  isAiGenerated          Boolean  @default(false)
  isHumanReviewed        Boolean  @default(false)
  glossaryEnabled        Boolean  @default(false)
  characterMemoryEnabled Boolean  @default(false)
  isPublic               Boolean  @default(true)
  isIndexable            Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  releases ChapterRelease[]

  @@index([isPublic, sortOrder])
}

model ReleaseGroup {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String           @unique
  name        String
  description String?
  website     String?
  verified    Boolean          @default(false)
  type        ReleaseGroupType
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  releases ChapterRelease[]
}

model ChapterRelease {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetLanguage          Languages
  sourceLanguage          Languages
  revision                Int           @default(1)
  status                  ReleaseStatus @default(DRAFT)
  publishedAt             DateTime?
  humanReviewed           Boolean       @default(false)
  glossaryUsed            Boolean       @default(false)
  characterMemoryUsed     Boolean       @default(false)
  translationQualityScore Int?
  ocrQualityScore         Int?
  cleanupQualityScore     Int?
  overallQualityScore     Int?
  internalEngineName      String?
  internalEngineVersion   String?
  pageCount               Int           @default(0)
  storagePrefix           String?
  isCanonicalForLanguage  Boolean       @default(false)
  isPublic                Boolean       @default(false)
  isIndexable             Boolean       @default(false)
  deletedAt               DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  chapter              PlatformChapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId            String                  @db.Uuid
  translationProfile   TranslationProfile      @relation(fields: [translationProfileId], references: [id])
  translationProfileId String                  @db.Uuid
  releaseGroup         ReleaseGroup?           @relation(fields: [releaseGroupId], references: [id])
  releaseGroupId       String?                 @db.Uuid
  pages                ReleasePage[]
  readingProgress      ReadingProgressRecord[]
  reports              ContentReport[]
  notifications        SiteNotification[]

  @@unique([chapterId, targetLanguage, translationProfileId, revision], map: "ChapterRelease_chapterId_targetLanguage_translationProfileId_re")
  @@index([chapterId, targetLanguage, isPublic, publishedAt], map: "ChapterRelease_chapterId_targetLanguage_isPublic_publishedAt_id")
  @@index([deletedAt, status])
}

model ReleasePage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageNumber Int
  storageKey String
  width      Int
  height     Int
  blurData   String?
  mimeType   String
  fileSize   BigInt?
  checksum   String?
  createdAt  DateTime @default(now())

  release   ChapterRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  releaseId String         @db.Uuid

  @@unique([releaseId, pageNumber])
}

model ReadingProgressRecord {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @db.Uuid
  chapterId   String    @db.Uuid
  pageNumber  Int
  scrollRatio Float
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  release   ChapterRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  releaseId String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseId])
  @@index([userId, updatedAt])
}

model ContentReport {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                 ReportType
  status               ReportStatus @default(OPEN)
  reasons              String[]
  description          String?
  attachmentStorageKey String?
  metadata             Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  adminNote            String?
  resolvedAt           DateTime?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String             @db.Uuid
  release       ChapterRelease     @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  releaseId     String             @db.Uuid
  assignedTo    User?              @relation("AssignedReports", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId  String?            @db.Uuid
  notifications SiteNotification[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([releaseId, createdAt])
}

model SeriesFollow {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastSeenReleaseAt DateTime?

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String @db.Uuid
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId String @db.Uuid

  @@unique([userId, seriesId])
  @@index([seriesId, createdAt])
  @@index([userId, updatedAt])
}

model NotificationPreference {
  followedSeriesUpdates Boolean  @default(true)
  reportStatusUpdates   Boolean  @default(true)
  accountUpdates        Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @id @db.Uuid
}

model SiteNotification {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      SiteNotificationType
  title     String
  message   String
  href      String?
  dedupeKey String               @unique
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String          @db.Uuid
  series    Series?         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesId  String?         @db.Uuid
  release   ChapterRelease? @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  releaseId String?         @db.Uuid
  report    ContentReport?  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId  String?         @db.Uuid

  @@index([userId, readAt, createdAt])
}

model ContentRevision {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType RevisionEntityType
  entityId   String             @db.Uuid
  action     RevisionAction
  before     Json?
  after      Json?
  createdAt  DateTime           @default(now())

  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorId String @db.Uuid

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model SlugRedirect {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType SlugEntityType
  entityId   String         @db.Uuid
  oldSlug    String
  locale     Languages?
  createdAt  DateTime       @default(now())

  @@unique([entityType, oldSlug, locale])
  @@index([entityType, entityId])
}

enum SeriesType {
  WEBTOON
  MANGA
  MANHWA
  MANHUA
  COMIC
  LIGHT_NOVEL
}

enum SeriesStatus {
  ONGOING
  COMPLETED
  HIATUS
  ANNOUNCED
  CANCELLED
}

enum PlatformContentRating {
  EVERYONE
  TEEN
  MATURE
}

enum SeriesAliasType {
  ORIGINAL
  ROMANIZED
  ENGLISH
  TURKISH
  ALTERNATIVE
  FORMER_TITLE
}

enum CreatorRole {
  AUTHOR
  ARTIST
  WRITER
  COLORIST
  STUDIO
}

enum ReleaseGroupType {
  OFFICIAL
  INTERNAL
  COMMUNITY
  PARTNER
}

enum ReleaseStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum SlugEntityType {
  SERIES
  CHAPTER
  GENRE
  CREATOR
}

enum ReportType {
  CHAPTER
  PANEL
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

enum SiteNotificationType {
  FOLLOWED_SERIES_RELEASE
  REPORT_STATUS
  ACCOUNT_UPDATE
}

enum RevisionEntityType {
  SERIES
  CHAPTER
  RELEASE
  REPORT
  USER
}

enum RevisionAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  BULK_UPDATE
}
