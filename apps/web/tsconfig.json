{
  "extends": "@taiyomoe/typescript/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "dom", "dom.iterable"],
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "paths": { "~/*": ["./src/*"] },
    "plugins": [{ "name": "next" }]
  },
  "include": [".", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
