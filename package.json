{
  "name": "taiyo",
  "private": true,
  "engines": {
    "node": "24.11.1"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "node tooling/with-root-env.mjs turbo build",
    "dev": "node tooling/with-root-env.mjs pnpm --filter @taiyomoe/web dev",
    "clean": "git clean -xdf node_modules",
    "clean:ws": "turbo clean",
    "check:ws": "biome check apps/ packages/ tooling/",
    "lint:ws": "pnpm dlx sherif@latest",
    "typecheck": "node tooling/with-root-env.mjs turbo typecheck",
    "setup:local": "node tooling/setup-local.mjs",
    "test:platform": "corepack pnpm --filter @taiyomoe/db exec tsx --test ../../apps/web/tests/platform.test.ts",
    "postinstall": "pnpm lint:ws",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@types/global-types": "workspace:^",
    "@types/node": "^24.10.1",
    "knip": "^5.70.1",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  }
}
