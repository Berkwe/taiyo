{
  "name": "taiyo",
  "private": true,
  "engines": {
    "node": "24.11.1"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "node tooling/with-root-env.mjs turbo build",
    "dev": "node tooling/with-root-env.mjs pnpm --filter @taiyomoe/web dev",
    "clean": "git clean -xdf node_modules",
    "clean:ws": "turbo clean",
    "check:ws": "biome check apps/ packages/ tooling/",
    "lint:ws": "pnpm dlx sherif@latest",
    "typecheck": "node tooling/with-root-env.mjs turbo typecheck",
    "setup:local": "node tooling/setup-local.mjs",
    "setup:mandown": "python3 -m venv .venv-mandown && .venv-mandown/bin/python -m pip install --disable-pip-version-check -r tooling/requirements-mandown.txt",
    "start:local": "./start-local.sh",
    "test:platform": "node tooling/with-root-env.mjs pnpm --filter @taiyomoe/db exec tsx --test ../../apps/web/tests/platform.test.ts",
    "test:management": "corepack pnpm --filter @taiyomoe/db exec tsx --test ../../apps/web/tests/management.test.ts",
    "test:auth": "corepack pnpm --filter @taiyomoe/web exec tsx --test tests/auth.test.ts",
    "test:auth-browser": "node apps/web/tests/auth-browser.mjs",
    "test:desktop-reader-browser": "node apps/web/tests/desktop-reader-browser.mjs",
    "test:browser": "node apps/web/tests/platform-browser.mjs",
    "test:chapter-sources-browser": "node apps/web/tests/chapter-sources-browser.mjs",
    "test:translation": "node tooling/with-root-env.mjs pnpm --filter @taiyomoe/db exec tsx --test ../../apps/web/tests/translation.test.ts",
    "test:translation-browser": "node apps/web/tests/translation-browser.mjs",
    "maintenance:storage": "node tooling/with-root-env.mjs pnpm exec tsx tooling/storage-maintenance.ts",
    "backup:database": "node tooling/with-root-env.mjs node tooling/database-backup.mjs",
    "backup:verify": "node tooling/with-root-env.mjs node tooling/database-restore-check.mjs",
    "storage:migrate:r2": "node tooling/with-root-env.mjs pnpm --filter @taiyomoe/storage migrate:r2",
    "postinstall": "pnpm lint:ws",
    "knip": "knip",
    "test:mandown-discovery": ".venv-mandown/bin/python -B tooling/test_mandown_discovery.py -v && node tooling/with-root-env.mjs pnpm --filter @taiyomoe/db exec tsx --test ../../apps/web/tests/mandown-discovery.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@types/global-types": "workspace:^",
    "@types/node": "^24.10.1",
    "knip": "^6.29.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "^7.29.6",
      "@rollup/pluginutils>picomatch": "^4.0.4",
      "ajv": "^8.20.0",
      "body-parser": "^2.3.0",
      "defu": "^6.1.7",
      "engine.io": "^6.6.9",
      "esbuild": "^0.28.1",
      "fast-uri": "^4.1.1",
      "find-my-way": "^9.7.0",
      "lodash": "^4.18.1",
      "next": "^16.2.12",
      "postcss": "^8.5.23",
      "prisma-zod-generator>js-yaml": "^4.3.0",
      "qs": "^6.15.3",
      "router>path-to-regexp": "^8.4.2",
      "rollup": "^4.62.3",
      "serialize-javascript": "^7.0.7",
      "sharp": "^0.35.3",
      "socket.io-parser": "^4.2.7",
      "unplugin>picomatch": "^4.0.4",
      "uuid": "^11.1.1",
      "valibot": "^1.4.2",
      "vite": "^7.3.5",
      "vitest>picomatch": "^4.0.4",
      "webpack": "^5.109.0",
      "ws": "^8.21.1"
    }
  }
}
