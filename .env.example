# Node environment, either "development" or "production"
NODE_ENV="development"

# Database
DATABASE_URL="postgres://postgres:postgres@localhost:5432/taiyo"
DATABASE_USERNAME="postgres"
DATABASE_PASSWORD="postgres"
DATABASE_NAME="taiyo"
DATABASE_PORT="5432"

# Authentication
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated origins that may submit authentication requests.
# Add the device-facing LAN URL here when testing from another device.
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
BETTER_AUTH_SECRET="local-development-only-change-before-production"
GOOGLE_CLIENT_ID="disabled"
GOOGLE_CLIENT_SECRET="disabled"
# Cloudflare's official always-pass test keys for localhost. Replace both in production.
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# Optional one-time bootstrap: the matching newly registered account becomes ADMIN.
BOOTSTRAP_ADMIN_EMAIL=""

# CDN
NEXT_PUBLIC_CDN_URL="http://localhost:4000"

# S3
S3_URL="http://localhost:9000"
S3_ACCESS_KEY_ID="local-development"
S3_SECRET_ACCESS_KEY="local-development"
S3_CDN_BUCKET_NAME="taiyo-development"
S3_UPLOADS_BUCKET_NAME="taiyo-uploads-development"

# NovoraScans managed content storage
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="storage"
BACKUP_DIRECTORY="backups/database"
BACKUP_RETENTION_DAYS="14"
# Required only when STORAGE_DRIVER="r2"
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="novorascans"
R2_PUBLIC_URL="https://media.example.com"

# Meilisearch
MEILISEARCH_MASTER_KEY="local-development-master-key"
MEILISEARCH_ADMIN_KEY="local-development-master-key"
MEILISEARCH_PORT="7700"
NEXT_PUBLIC_MEILISEARCH_URL="http://localhost:7700"
NEXT_PUBLIC_MEILISEARCH_PUBLIC_KEY="local-development-master-key"

# Dragonfly
DRAGONFLY_PORT="6379"
DRAGONFLY_URL="redis://:@localhost:6379/0"

# ClickHouse
CLICKHOUSE_URL="http://clickhouse:clickhouse@localhost:8123"
CLICKHOUSE_USERNAME="clickhouse"
CLICKHOUSE_PASSWORD="clickhouse"
CLICKHOUSE_HTTP_PORT="8123"
CLICKHOUSE_TCP_PORT="9000"

# Umami
NEXT_PUBLIC_UMAMI_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
UMAMI_USER_ID=""
UMAMI_SECRET=""

# PostHog (disabled until a real project key is supplied)
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_POSTHOG_KEY="disabled"

# Grafana
GRAFANA_USERNAME="admin"
GRAFANA_PASSWORD="admin"
GRAFANA_LOKI_URL="http://localhost:3100"

# Transactional email. Local development uses Mailpit:
# inbox UI: http://localhost:8025
EMAIL_TRANSPORT="smtp"
EMAIL_FROM="NovoraScans <no-reply@novorascans.local>"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAILPIT_UI_PORT="8025"
# Production alternative: set EMAIL_TRANSPORT=resend and provide a verified
# EMAIL_FROM domain plus RESEND_API_KEY.
RESEND_API_KEY=""

# Optional local observability UI
HYPERDX_PORT="8080"

# Translation catalog, pricing and community funding
SOURCE_CATALOG_PROVIDER="mandown"
MANDOWN_PYTHON=".venv-mandown/bin/python"
MANDOWN_DOWNLOAD_ROOT="storage/mandown"
TRANSLATION_BALANCED_CREDITS="100"
TRANSLATION_PREMIUM_CREDITS="150"
MAX_CHAPTERS_PER_REQUEST="10"
CONTRIBUTOR_EARLY_ACCESS_HOURS="24"
