{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": false
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "DISCORD_CLIENT_ID",
    "DISCORD_CLIENT_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "TURNSTILE_SECRET_KEY",
    "BOOTSTRAP_ADMIN_EMAIL",
    "MEILISEARCH_ADMIN_KEY",
    "DRAGONFLY_URL",
    "S3_URL",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_CDN_BUCKET_NAME",
    "S3_UPLOADS_BUCKET_NAME",
    "STORAGE_DRIVER",
    "LOCAL_STORAGE_PATH",
    "R2_ENDPOINT",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET",
    "R2_PUBLIC_URL",
    "CLICKHOUSE_URL",
    "UMAMI_USER_ID",
    "UMAMI_SECRET",
    "GRAFANA_USERNAME",
    "GRAFANA_PASSWORD",
    "GRAFANA_LOKI_URL",
    "RESEND_API_KEY"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "npm_lifecycle_event",
    "MANDOWN_PYTHON",
    "MANDOWN_DOWNLOAD_ROOT",
    "MANDOWN_JEV_CACHE",
    "MANDOWN_JEV_CACHE_REVISION",
    "MANDOWN_SEARCH_LOG",
    "JEVMODEL_API_KEY",
    "JEVMODEL_API_KEY_FALLBACK",
    "JEVMODEL_API_KEY_FALLBACK_2",
    "JEVMODEL_API_KEY_FALLBACK_3",
    "JEVMODEL_API_KEY_FALLBACK_4",
    "JEVMODEL_API_KEY_FALLBACK_5",
    "JEVMODEL_API_KEY_FALLBACK_6",
    "JEVMODEL_API_KEY_FALLBACK_7",
    "JEVMODEL_API_KEY_FALLBACK_8",
    "JEVMODEL_API_KEY_FALLBACK_9"
  ]
}
